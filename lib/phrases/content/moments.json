{
  "despertar": [
    { "text": "Ya es de día, mi amor.", "translation": "It's daytime, my love." },
    { "text": "¿Quién se despertó tan contento?", "translation": "Who woke up so happy?" },
    { "text": "Buen día, dormilón.", "translation": "Good morning, sleepyhead." },
    { "text": "Estira los bracitos.", "translation": "Stretch your little arms." },
    { "text": "Despacito, sin apuro.", "translation": "Nice and slow, no rush." },
    { "text": "Todavía tienes carita de sueño.", "translation": "You've still got a sleepy little face." },
    { "text": "Vamos a cambiarte, estás mojadito.", "translation": "Let's get you changed, you're a bit wet." },
    { "text": "Vamos a preparar el desayuno.", "translation": "Let's make breakfast." },
    { "text": "Hoy va a ser un lindo día.", "translation": "Today's going to be a lovely day." },
    { "text": "¿Dormiste toda la noche? ¡Qué campeón!", "translation": "You slept all night? What a champ!" },
    { "text": "¿Escuchaste? Ya cantan los pájaros.", "translation": "Did you hear? The birds are already singing." },
    { "text": "Vamos a vestirnos.", "translation": "Let's get dressed." },
    { "text": "¿Ba-ba-ba? ¡Ba-ba-ba!", "translation": "Ba-ba-ba? Ba-ba-ba!", "maxMonths": 14, "draft": true },
    { "text": "¿Ah, sí? ¿Y qué más?", "translation": "Oh really? And what else?", "maxMonths": 14, "draft": true },
    { "text": "¿Me estás contando algo?", "translation": "Are you telling me something?", "maxMonths": 14, "draft": true },
    { "text": "Te escucho, sigue.", "translation": "I'm listening, go on.", "maxMonths": 14, "draft": true },
    { "text": "¿Qué miras? Ah, la ventana.", "translation": "What are you looking at? Oh, the window.", "maxMonths": 14, "draft": true },
    { "text": "¡Da-da-da! Qué charlatán.", "translation": "Da-da-da! What a chatterbox.", "maxMonths": 14, "draft": true },
    { "text": "Ahora te toca a ti.", "translation": "Now it's your turn.", "maxMonths": 14, "draft": true }
  ],
  "cambiar": [
    { "text": "Vamos al cambiador.", "translation": "Off to the changing mat." },
    { "text": "¿Hiciste caca? A ver.", "translation": "Have you done a poo? Let's see." },
    { "text": "Uy, qué pañal tan lleno.", "translation": "Ooh, what a full nappy." },
    { "text": "Uy, la toallita está fría.", "translation": "Ooh, the wipe's cold." },
    { "text": "Un poco de crema para la colita.", "translation": "A bit of cream for your bottom." },
    { "text": "Patea, patea, ¡qué fuerte!", "translation": "Kick, kick, so strong!" },
    { "text": "Hace frío, te tapo rápido.", "translation": "It's chilly, I'll cover you up quickly." },
    { "text": "Ahora el body, mete el bracito.", "translation": "Now your vest, pop your little arm in." },
    { "text": "Por la cabeza y... ¡cucú!", "translation": "Over your head and... peekaboo!" },
    { "text": "Abrocho los botones, uno, dos, tres.", "translation": "I'll do up the poppers, one, two, three." },
    { "text": "Las medias, una y dos.", "translation": "Your socks, one and two." },
    { "text": "Ya está, cambiadito y lindo.", "translation": "All done, changed and looking lovely." }
  ],
  "comida": [
    { "text": "A la sillita, es hora de comer.", "translation": "Into the high chair, it's time to eat." },
    { "text": "Prueba un poquito.", "translation": "Try a little bit." },
    { "text": "Está calentito, sopla.", "translation": "It's warm, blow on it.", "minMonths": 18 },
    { "text": "¿Te gusta? Es banana.", "translation": "Do you like it? It's banana." },
    { "text": "Toma la cuchara, prueba tú.", "translation": "Take the spoon, you try.", "minMonths": 12 },
    { "text": "Un poquito de agua.", "translation": "A little bit of water." },
    { "text": "No se tira la comida.", "translation": "We don't throw food.", "minMonths": 12 },
    { "text": "Qué bien comes solito.", "translation": "You're eating so well by yourself.", "minMonths": 18 },
    { "text": "¿Está rico el puré?", "translation": "Is the purée yummy?" },
    { "text": "Último bocado y listo.", "translation": "Last bite and we're done." },
    { "text": "Ahora las manitas, a lavarlas.", "translation": "Now your little hands, let's wash them." },
    { "text": "Buen provecho, mi amor.", "translation": "Enjoy your food, my love." },
    { "text": "Hoy probamos algo nuevo.", "translation": "Today we're trying something new.", "minMonths": 6, "maxMonths": 14, "draft": true },
    { "text": "A ver, el babero, que esto mancha.", "translation": "Right, bib on, this stains.", "minMonths": 6, "maxMonths": 14, "draft": true },
    { "text": "Abre grande, mira la cuchara.", "translation": "Open wide, look at the spoon.", "minMonths": 6, "maxMonths": 14, "draft": true },
    { "text": "Es papilla de zapallo, ¿te gusta?", "translation": "It's squash purée, do you like it?", "minMonths": 6, "maxMonths": 14, "draft": true },
    { "text": "Qué cara pusiste. Es nuevo, ¿no?", "translation": "What a face! It's new, isn't it?", "minMonths": 6, "maxMonths": 14, "draft": true },
    { "text": "Despacito, de a poquito.", "translation": "Gently, a little at a time.", "minMonths": 6, "maxMonths": 14, "draft": true },
    { "text": "Mmm, qué rica la pera.", "translation": "Mmm, the pear's lovely.", "minMonths": 6, "maxMonths": 14, "draft": true },
    { "text": "Toma, agárralo con la mano.", "translation": "Here, hold it in your hand.", "minMonths": 6, "maxMonths": 14, "draft": true },
    { "text": "Tienes papilla hasta en la nariz.", "translation": "You've got purée even on your nose.", "minMonths": 6, "maxMonths": 14, "draft": true },
    { "text": "¿Ya no tienes hambre? Está bien.", "translation": "Not hungry any more? That's fine.", "minMonths": 6, "maxMonths": 14, "draft": true }
  ],
  "juego": [
    { "text": "¿A qué jugamos?", "translation": "What shall we play?", "minMonths": 18 },
    { "text": "¿Dónde está la pelota?", "translation": "Where's the ball?", "minMonths": 12 },
    { "text": "Pásamela. ¡Muy bien!", "translation": "Pass it to me. Well done!", "minMonths": 12 },
    { "text": "Una torre más alta, ¿puedes?", "translation": "An even taller tower, can you do it?", "minMonths": 18 },
    { "text": "¡Se cayó! No pasa nada.", "translation": "It fell down! That's OK." },
    { "text": "¿Dónde estás? ¡Aquí estás!", "translation": "Where are you? There you are!" },
    { "text": "Otra vez, ¿quieres?", "translation": "Again? Do you want to?" },
    { "text": "Este es el rojo, este es el azul.", "translation": "This one's red, this one's blue." },
    { "text": "¡Qué rápido corres!", "translation": "How fast you run!", "minMonths": 18 },
    { "text": "Dame la mano, bailamos.", "translation": "Give me your hand, let's dance.", "minMonths": 12 },
    { "text": "Guardamos los juguetes juntos.", "translation": "Let's put the toys away together.", "minMonths": 18 },
    { "text": "Eso es, tú puedes.", "translation": "That's it, you can do it." },
    { "text": "Un ratito boca abajo.", "translation": "A little while on your tummy.", "maxMonths": 9, "draft": true },
    { "text": "Arriba la cabecita, ¡qué fuerte!", "translation": "Head up, so strong!", "maxMonths": 9, "draft": true },
    { "text": "Mírame, aquí estoy.", "translation": "Look at me, I'm here.", "maxMonths": 9, "draft": true },
    { "text": "¿Alcanzas el sonajero? Estira la mano.", "translation": "Can you reach the rattle? Stretch your hand out.", "maxMonths": 9, "draft": true },
    { "text": "Casi, casi... ¡lo agarraste!", "translation": "Almost, almost... you got it!", "maxMonths": 9, "draft": true },
    { "text": "Mira el espejo. ¿Quién es ese bebé?", "translation": "Look in the mirror. Who's that baby?", "maxMonths": 9, "draft": true },
    { "text": "Te cansaste, te doy la vuelta.", "translation": "You're tired, I'll roll you over.", "maxMonths": 9, "draft": true }
  ],
  "paseo": [
    { "text": "¿Vamos a la plaza?", "translation": "Shall we go to the square?" },
    { "text": "Mira las flores. ¿Las hueles?", "translation": "Look at the flowers. Can you smell them?" },
    { "text": "¿Oyes eso? Es un camión.", "translation": "Do you hear that? It's a truck." },
    { "text": "Vamos despacio, sin correr.", "translation": "Let's go slowly, no running.", "minMonths": 18 },
    { "text": "Dame la mano para cruzar.", "translation": "Hold my hand to cross.", "minMonths": 18 },
    { "text": "Mira, un gatito en la ventana.", "translation": "Look, a little cat in the window." },
    { "text": "¿Saludamos al vecino?", "translation": "Shall we say hi to the neighbour?" },
    { "text": "Qué viento hace hoy.", "translation": "It's so windy today." },
    { "text": "Una vuelta más a la manzana.", "translation": "One more lap around the block." },
    { "text": "¿Estás cansado? Te llevo.", "translation": "Are you tired? I'll carry you.", "minMonths": 18 },
    { "text": "Pisamos las hojas. ¡Crunch!", "translation": "Let's step on the leaves. Crunch!", "minMonths": 18 },
    { "text": "Casi llegamos a casa.", "translation": "We're almost home." }
  ],
  "baño": [
    { "text": "Vamos a preparar el agua.", "translation": "Let's get the water ready." },
    { "text": "A quitarse la ropa.", "translation": "Let's take your clothes off." },
    { "text": "¿Está rica el agua?", "translation": "Is the water nice?" },
    { "text": "¿Dónde está tu patito?", "translation": "Where's your little duck?" },
    { "text": "Un poquito de jabón.", "translation": "A little bit of soap." },
    { "text": "Cierra los ojos, viene el agua.", "translation": "Close your eyes, here comes the water." },
    { "text": "Lavamos los piecitos.", "translation": "Let's wash your little feet." },
    { "text": "No tires agua afuera, amor.", "translation": "Don't splash water out, love.", "minMonths": 12 },
    { "text": "Ya está, a salir.", "translation": "All done, out you come." },
    { "text": "Envuelto como un burrito.", "translation": "Wrapped up like a little burrito." },
    { "text": "Vamos a peinarte.", "translation": "Let's comb your hair." },
    { "text": "Crema para la pancita.", "translation": "Cream for your tummy." }
  ],
  "calmar": [
    { "text": "Ya, ya, aquí estoy.", "translation": "There, there, I'm here." },
    { "text": "Tranquilo, mi amor.", "translation": "Easy, my love." },
    { "text": "¿Qué pasó, mi vida?", "translation": "What happened, sweetheart?" },
    { "text": "Ven, un abrazo fuerte.", "translation": "Come here, a big hug." },
    { "text": "Ya pasó, ya pasó.", "translation": "It's over now, it's over." },
    { "text": "Respira conmigo, despacito.", "translation": "Breathe with me, nice and slow.", "minMonths": 18 },
    { "text": "Estoy contigo, no te preocupes.", "translation": "I'm with you, don't worry." },
    { "text": "¿Te duele algo? Muéstrame.", "translation": "Does something hurt? Show me.", "minMonths": 18 },
    { "text": "Shh, shh, todo está bien.", "translation": "Shh, shh, everything's OK." },
    { "text": "Llora tranquilo, aquí te tengo.", "translation": "It's OK to cry, I've got you." },
    { "text": "¿Quieres tu peluche?", "translation": "Do you want your cuddly toy?" },
    { "text": "Un besito y se pasa.", "translation": "A little kiss and it'll pass." },
    { "text": "Te duelen los dientitos, ¿no?", "translation": "Your little teeth hurt, don't they?", "minMonths": 4, "maxMonths": 14, "draft": true },
    { "text": "Toma el mordillo, está fresquito.", "translation": "Here's your teething ring, it's nice and cold.", "minMonths": 4, "maxMonths": 14, "draft": true },
    { "text": "Muerde fuerte, eso ayuda.", "translation": "Bite down hard, that helps.", "minMonths": 4, "maxMonths": 14, "draft": true },
    { "text": "Te masajeo las encías.", "translation": "I'll rub your gums.", "minMonths": 4, "maxMonths": 14, "draft": true },
    { "text": "¿Asoma un diente nuevo? ¡A ver!", "translation": "Is a new tooth coming through? Let me see!", "minMonths": 4, "maxMonths": 14, "draft": true },
    { "text": "Cuánta baba, mi amor.", "translation": "So much dribble, my love.", "minMonths": 4, "maxMonths": 14, "draft": true },
    { "text": "Ya sé que molesta, ya va a salir.", "translation": "I know it's sore, it'll come through soon.", "minMonths": 4, "maxMonths": 14, "draft": true }
  ],
  "dormir": [
    { "text": "Última canción y a la cama.", "translation": "One last song and off to bed." },
    { "text": "Busca tu mantita.", "translation": "Find your little blanket.", "minMonths": 18 },
    { "text": "Hoy jugaste muchísimo.", "translation": "You played so much today." },
    { "text": "Mañana seguimos jugando.", "translation": "We'll play more tomorrow." },
    { "text": "Despacito, a la cuna.", "translation": "Gently now, into the cot." },
    { "text": "Canto bajito, tú descansa.", "translation": "I'll sing softly, you rest." },
    { "text": "Los juguetes también duermen.", "translation": "The toys are sleeping too.", "minMonths": 18 },
    { "text": "Dejo la lucecita prendida.", "translation": "I'll leave the little light on." },
    { "text": "Mamá y papá están cerca.", "translation": "Mummy and daddy are close by." },
    { "text": "Sueña con cosas lindas.", "translation": "Dream of lovely things." },
    { "text": "Nos vemos cuando salga el sol.", "translation": "See you when the sun comes up." },
    { "text": "Un último besito.", "translation": "One last little kiss." },
    { "text": "Tus ojitos dicen que tienes sueño.", "translation": "Your little eyes say you're sleepy.", "minMonths": 6, "maxMonths": 14, "draft": true },
    { "text": "Una siestita y después jugamos.", "translation": "A little nap and then we'll play.", "minMonths": 6, "maxMonths": 14, "draft": true },
    { "text": "Te pongo el saco de dormir.", "translation": "Let's put your sleeping bag on.", "minMonths": 6, "maxMonths": 14, "draft": true },
    { "text": "Prendo el ruido blanco.", "translation": "I'll put the white noise on.", "minMonths": 6, "maxMonths": 14, "draft": true },
    { "text": "Te dejo boca arriba, así.", "translation": "I'll lay you on your back, like this.", "minMonths": 6, "maxMonths": 14, "draft": true },
    { "text": "Una tomita y a la cuna.", "translation": "A little feed and back into the cot.", "minMonths": 6, "maxMonths": 14, "draft": true },
    { "text": "Shh, es de noche, a dormir otra vez.", "translation": "Shh, it's night-time, back to sleep.", "minMonths": 6, "maxMonths": 14, "draft": true }
  ]
}
